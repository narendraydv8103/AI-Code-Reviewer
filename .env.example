# ===== LLM PROVIDER =====
# Active provider: 'gemini' (recommended free tier) or 'anthropic'
LLM_PROVIDER=gemini

# Google Gemini API Key & Settings (Free tier available at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_SECONDS=60
# GEMINI_MAX_TOKENS=4096

# Minimum delay between LLM calls in seconds (default: 4.0 for Gemini 15 RPM free tier, 0 for Anthropic)
# LLM_MIN_INTERVAL_SECONDS=4.0

# ===== Optional: use Anthropic instead (set LLM_PROVIDER=anthropic) =====
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_TIMEOUT_SECONDS=60
# ANTHROPIC_MAX_TOKENS=4096

# Safeguards & Limits for Web UI
# MAX_CODE_CHARS=60000

# GitHub App Configurations
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=/path/to/your-app-private-key.pem
# Alternatively, inline PEM key:
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Bot Limits & Filtering
MIN_SEVERITY=low
MAX_FILES=20
MAX_DIFF_CHARS=100000
MAX_LLM_CALLS_PER_PR=8
MIN_CONFIDENCE=0.5

# Database Path (mount a directory volume for SQLite WAL files)
DB_PATH=/app/data/reviews.db

# Hardening & Quotas
# Set TRUST_PROXY=true when behind an HTTPS reverse proxy (nginx, cloudflare, fly.io)
TRUST_PROXY=false
MAX_REVIEWS_PER_DAY=200
RATE_LIMIT_PER_MINUTE=20

# Optional Security Tokens (leave empty to disable)
# ACCESS_TOKEN=your_secret_access_token_here
# DASHBOARD_PASSWORD=your_dashboard_password_here
